# Orchestration Framework Environment Configuration
# Copy to .env and customize for your deployment

# ──────────────────────────────────────────────────────────
# STATE STORE CONFIGURATION
# ──────────────────────────────────────────────────────────

# SQLite database path (file-based, durable)
STATE_STORE_DB_PATH=.tasks/state.db

# Redis cache (optional, improves latency)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# PostgreSQL (optional, for audit logs scaling)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orchestration
POSTGRES_USER=orch_user
POSTGRES_PASSWORD=orchestration_dev_password

# ──────────────────────────────────────────────────────────
# AUTONOMOUS WORKER CONFIGURATION
# ──────────────────────────────────────────────────────────

# Worker identification
WORKER_ID=worker-001
WORKER_TYPE=local  # local, aws, gcp, azure

# Retry strategy
WORKER_MAX_RETRIES=3
WORKER_INITIAL_BACKOFF=1
WORKER_MAX_BACKOFF=60

# Timeouts (seconds)
WORKER_PHASE_TIMEOUT=3600
WORKER_HEARTBEAT_INTERVAL=5
WORKER_STALL_TIMEOUT=30

# ──────────────────────────────────────────────────────────
# CLOUD BRANCHES CONFIGURATION
# ──────────────────────────────────────────────────────────

# Cloud provider selection
CLOUD_PROVIDER=aws_lambda  # aws_lambda, gcp_cloud_run, azure_functions, local

# AWS Lambda
AWS_REGION=us-east-1
AWS_LAMBDA_FUNCTION_NAME=orchestration-worker
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GCP Cloud Run
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_WORKER_IMAGE=us.gcr.io/your-project/orchestration-worker:latest
GCP_SERVICE_ACCOUNT=

# Azure Functions
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_FUNCTION_APP=

# Cost Control
CLOUD_COST_MONITORING=true
CLOUD_COST_LIMIT_CENTS=1000  # $10 max per phase
CLOUD_FALLBACK_TO_LOCAL=true

# ──────────────────────────────────────────────────────────
# COORDINATOR CONFIGURATION
# ──────────────────────────────────────────────────────────

# Coordinator behavior
COORDINATOR_ID=coordinator-001
COORDINATOR_TIMEOUT=300  # seconds waiting for workers
COORDINATOR_WATCHDOG_ENABLED=true
COORDINATOR_WATCHDOG_INTERVAL=10  # seconds between checks

# Communication
COORDINATOR_CALLBACK_TIMEOUT=10  # seconds for decision callback

# ──────────────────────────────────────────────────────────
# LOGGING & OBSERVABILITY
# ──────────────────────────────────────────────────────────

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text
LOG_FILE=logs/orchestration.log

# Structured logging
STRUCTURED_LOGGING=true
TRACE_LOGGING=false

# Observability
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=8000
PROMETHEUS_METRICS_PATH=/metrics

# Distributed tracing (OpenTelemetry)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ──────────────────────────────────────────────────────────
# IDE INTEGRATION
# ──────────────────────────────────────────────────────────

# Terminal/Workspace names (for herdr/Claude Code)
ENABLE_ADAPTIVE_NAMES=true
TERMINAL_PREFIX=[Orchestration]
SHOW_PHASE_IN_NAME=true
SHOW_WORKER_TYPE_IN_NAME=true

# ──────────────────────────────────────────────────────────
# SKILL MANAGEMENT
# ──────────────────────────────────────────────────────────

# Skill registry
SKILLS_BASE_PATH=.claude/skills
ENABLE_SKILL_REGISTRY=true
SKILL_REGISTRY_CHECK_INTERVAL=3600  # seconds, verify skills hourly

# Skill versioning
ENFORCE_SKILL_COMPATIBILITY=true
FAIL_ON_MISSING_SKILL=true
FAIL_ON_VERSION_MISMATCH=false  # warn only

# ──────────────────────────────────────────────────────────
# DEPLOYMENT ENVIRONMENT
# ──────────────────────────────────────────────────────────

# Environment type
ENVIRONMENT=development  # development, staging, production
DEBUG=false

# Service discovery
SERVICE_MESH_ENABLED=false  # Istio, Linkerd, etc.
KUBERNETES_ENABLED=false  # Running in K8s?

# ──────────────────────────────────────────────────────────
# OPTIONAL: DATABASE MIGRATIONS
# ──────────────────────────────────────────────────────────

# Auto-run migrations on startup
AUTO_MIGRATE=true
MIGRATION_PATH=scripts/migrations
MIGRATION_LOG=logs/migrations.log

# ──────────────────────────────────────────────────────────
# SECURITY
# ──────────────────────────────────────────────────────────

# Credentials (keep these secret!)
# Load from secrets manager in production

COORDINATOR_SECRET_KEY=
WORKER_REGISTRATION_TOKEN=

# TLS/SSL
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# ──────────────────────────────────────────────────────────
# FEATURE FLAGS
# ──────────────────────────────────────────────────────────

# Enable heartbeat mechanism (Phase 3.1)
ENABLE_HEARTBEAT=false

# Enable watchdog timeout detection (Phase 3.1)
ENABLE_WATCHDOG=false

# Enable event sourcing (Phase 3.1)
ENABLE_EVENT_SOURCING=false

# Enable skill registry (Phase 3.1)
ENABLE_SKILL_REGISTRY=false

# Enable DAG visualization (Phase 3.2)
ENABLE_DAG_VISUALIZATION=false
