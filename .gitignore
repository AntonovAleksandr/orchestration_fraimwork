# =============================================================================
# GJ-Ecommerce — agentic workspace repository
# =============================================================================
# Tracked: CLAUDE.md, docs/, .claude/{agents,skills,rules}/, .cursor/rules/ (symlinks)
# Not tracked: platform clones, GSD installer output, .cursor autogen, secrets, logs/* (except logs/README.md)

# Cloned platform repositories — each platform/<system>/* is its own git repo.
platform/*/*
!platform/*/README.md

# New e-commerce platform — clients / gateway / checkout + go-pkg libs.
# Each subdir is its own git repo (e-commerce/platform/*, go-pkg/*); never tracked here.
platform-new/

# Experimental / next-generation mini platform workspaces.
# These are standalone repos with their own git roots and are documented from the workspace index.
platform-next/

# macOS / IDE noise
.DS_Store
**/.DS_Store
.idea/
.vscode/

# =============================================================================
# .claude — canonical agent config (see .claude/README.md)
# =============================================================================

# Tracked: agents/, skills/ (GJ only), rules/
# Autogenerated — GSD: npx get-shit-done-cc@latest --claude --local --profile=core
.claude/commands/
.claude/get-shit-done/
.claude/hooks/
.claude/settings.json
.claude/gsd-file-manifest.json
.claude/gsd-install-state.json
.claude/package.json
.claude/.gsd-profile
.claude/VERSION
.claude/worktrees/
.claude/skills/gsd-*/

# Personal Claude Code approvals (machine-specific)
.claude/settings.local.json

# =============================================================================
# Codex adapters — generated from .claude/*, local only
# =============================================================================

.codex/
.agents/

# =============================================================================
# .cursor — only rules symlinks are tracked (→ .claude/rules/)
# =============================================================================

# Autogenerated — optional GSD for Cursor UX:
#   npx get-shit-done-cc@latest --cursor --local --profile=core
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# =============================================================================
# GSD project artifacts (optional team tracking — uncomment to share roadmap)
# =============================================================================
# .planning/

# Secrets
.env
.env.local

# Local investigation dumps (long log/code autopsy — not for git)
logs/*
!logs/README.md

.superpowers
